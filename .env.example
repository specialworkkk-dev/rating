# Copy to .env.local and fill in. Never commit .env.local.
MONGODB_URI=mongodb://127.0.0.1:27017/review-booster
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
ALERT_FROM_EMAIL=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Public email for privacy questions, deletion requests and complaints
# (shown on /privacy and /terms). Redeploy after changing it.
NEXT_PUBLIC_CONTACT_EMAIL=

# Daily cleanup of old raw records (Vercel Cron). Any long random string.
CRON_SECRET=
# Months of raw ratings/scans to keep (default 3, minimum 2). Totals and charts keep everything.
RAW_KEEP_MONTHS=3

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Review Booster Token (RBT): see token/LAUNCH.md. Leave empty until launch.
TOKEN_NETWORK=
TOKEN_ADDRESS=
TOKEN_VESTING_ADDRESS=
TOKEN_LIQUIDITY_WALLET=
TOKEN_BURN_RESERVE_WALLET=
TOKEN_LP_PAIR=
TOKEN_BURN_WALLET_KEY=
TOKEN_BURN_START=
TOKEN_BURN_PER_RATING=10
TOKEN_MAX_BURN_PER_DAY=500000
# "Owners told", "Lawyer & CA approved" and "Pause daily burns" are switches
# in Admin → Token (stored in the database), not settings here.

# Offers (premium): free browser notifications. Create once with
# `node scripts/vapid-keys.mjs`. Changing them later disconnects every follower.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
